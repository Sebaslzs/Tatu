# Copiar a .env y completar. Este archivo NO lleva secretos (RNF-01).

# --- API ---
PORT=3000

# PostgreSQL en Supabase por el pooler (5432 «Session» en local, 6543 «Transaction» en Vercel).
# Vacío: se usa PGlite en server/data/pglite (AD-23).
DATABASE_URL=

# URLs de la app (en Vercel salen del dominio)
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api
LIQUIDACION_URL=http://localhost:3000/api/liquidacion
LIQUIDACION_TIMEOUT_MS=5000
# Minutos que espera una aprobación antes de volver a Borrador (CA-01.08)
APROBACION_TTL_MIN=10
# Cobro en el punto (HU-11): tiempo para confirmar, PIN permitidos y bloqueo de la cédula
CONFIRMACION_TTL_SEG=120
PIN_MAX_INTENTOS=3
PIN_BLOQUEO_MIN=15
PUENTE_URL=http://localhost:3000/api/puente
PUENTE_TIMEOUT_MS=5000
# subject: la persona aprueba en su billetera · simulada: plan B, se da por verificada (HU-07)
VERIFICACION_CUENTA=subject

# Cadencia de consulta del estado de un cobro (AD-16)
POLL_INTERVALO_MS=1000

# --- Open Payments (Interledger Test Wallet) · solo backend ---
OP_CLIENT_WALLET_ADDRESS=
OP_KEY_ID=
# En local: ruta a la llave privada FUERA del repo. En Vercel: OP_PRIVATE_KEY_BASE64.
OP_PRIVATE_KEY_PATH=
OP_PRIVATE_KEY_BASE64=

# --- Extras (RNF-10): apagados no rompen el flujo principal ---
EXTRA_BONO=false
EXTRA_QR=false
EXTRA_PDF417=false
EXTRA_CONTRATO=false
EXTRA_DEPLOY=false
